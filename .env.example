# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
MIN_CONFIDENCE_THRESHOLD=0.50
MAX_TOOL_RETRIES=2

# ServiceNow PDI - never commit real values
SNOW_INSTANCE=https://YOUR_INSTANCE.service-now.com
SNOW_USERNAME=
SNOW_PASSWORD=

# Demo / evaluation
AUTO_APPROVE=false
USE_MOCK_SERVICENOW=true
OFFLINE_LLM=false
LOG_LEVEL=INFO
